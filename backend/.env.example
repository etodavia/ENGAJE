# ============================================================================
# ENGAJE SOLUÇÕES — CONFIGURAÇÃO DE AMBIENTE DO BACK-END (.env.example)
# Copie este arquivo para ".env" e preencha com as credenciais locais do MySQL.
# Nunca versione o arquivo ".env" com senhas reais.
# ============================================================================

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Configuração do Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=engaje_db
DB_CONNECTION_LIMIT=10
